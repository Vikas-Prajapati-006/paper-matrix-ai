# ==================================================
# 1. Environments & Virtual Environments
# ==================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ==================================================
# 2. Secrets & API Keys (CRITICAL: Never Commit)
# ==================================================
.env
.env.*
*.env
# Allow example file for GitHub reference
!.env.example

# ==================================================
# 3. Python Cache, Bytecode & Build Artifacts
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
develop-eggs/
.pytest_cache/
.coverage
htmlcov/

# ==================================================
# 4. Logs & Local Storage
# ==================================================
logs/
*.log
*.sqlite3
*.rdb
*.aof

# ==================================================
# 5. Frontend (AstroJS, Node.js, Tailwind, Vite)
# ==================================================
node_modules/
.astro/
frontend/node_modules/
frontend/.astro/
frontend/dist/
dist/
.output/

# ==================================================
# 6. Operating System & IDE Junk
# ==================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# Nested .env files in subfolders (backend/.env, frontend/.env.local)
**/.env
**/.env.*
!**/.env.example

# Frontend build cache & npm logs
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage artifacts
.tox/
.nox/