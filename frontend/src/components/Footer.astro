---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-zinc-900 bg-[#09090b]/60 backdrop-blur-sm py-8 px-4">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
    <div class="flex items-center gap-2">
      <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
      <span>PaperMatrix AI © {currentYear}</span>
      <span class="text-zinc-700">•</span>
      <span class="text-zinc-400">High-Density Research OS</span>
    </div>

    <div class="flex items-center gap-4">
      <a href="/privacy" class="hover:text-zinc-300 transition-colors">Privacy</a>
      <span class="text-zinc-800">/</span>
      <a href="/terms" class="hover:text-zinc-300 transition-colors">Terms</a>
      <span class="text-zinc-800">/</span>
      <a href="/contact" class="hover:text-zinc-300 transition-colors">Contact</a>
    </div>
  </div>
</footer>