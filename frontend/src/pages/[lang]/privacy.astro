---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
---

<BaseLayout title="Privacy Policy — PaperMatrix AI">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-16 text-zinc-300">
    <div class="border-b border-zinc-800 pb-6 mb-8">
      <h1 class="text-2xl font-bold text-zinc-100 tracking-tight">Privacy Policy</h1>
      <p class="text-xs font-mono text-zinc-500 mt-1">International Compliance Standard</p>
    </div>

    <div class="space-y-8 text-xs leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-sm font-semibold text-zinc-100 uppercase tracking-wider font-mono">1. Zero Retention</h2>
        <p class="text-zinc-400">
          Documents uploaded are processed transiently in random-access memory. No physical disk persistence occurs.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-sm font-semibold text-zinc-100 uppercase tracking-wider font-mono">2. Anonymized Quota Hashing</h2>
        <p class="text-zinc-400">
          Rate limiting relies on one-way hardware signatures devoid of personal identifying attributes.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>