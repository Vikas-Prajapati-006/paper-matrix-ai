---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Page Not Found">
  <Header />
  <main class="flex-1 max-w-2xl mx-auto w-full px-4 flex flex-col items-center justify-center text-center py-24">
    <div class="h-12 w-12 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center font-mono text-zinc-400 text-sm font-bold mb-4">
      404
    </div>
    <h1 class="text-xl font-bold text-zinc-100 mb-2">Page Not Found</h1>
    <p class="text-xs text-zinc-400 font-mono max-w-sm mb-6">
      The paper or path you requested does not exist in the matrix index.
    </p>
    <a
      href="/"
      class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium transition-colors"
    >
      Return to Dashboard
    </a>
  </main>
  <Footer />
</BaseLayout>