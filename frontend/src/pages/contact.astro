---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact — PaperMatrix AI">
  <Header />

  <main class="flex-1 max-w-xl mx-auto w-full px-4 sm:px-6 py-16 flex flex-col items-center">
    <div class="text-center space-y-2 mb-8">
      <h1 class="text-2xl font-bold text-zinc-100 tracking-tight">Contact</h1>
      <p class="text-xs text-zinc-400 font-mono">
        Questions about synthesis accuracy, API access, or rate limits? Reach out directly.
      </p>
    </div>

    <div class="w-full bg-zinc-900/40 p-6 sm:p-8 rounded-2xl border border-zinc-800/80 backdrop-blur-sm shadow-xl space-y-6">
      <div class="space-y-1.5">
        <label class="block text-xs font-mono text-zinc-300">Direct Support</label>
        <div class="p-3 rounded-lg border border-zinc-800 bg-zinc-950/60 text-xs text-zinc-300 font-mono select-all">
          contact@papermatrix.ai
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-mono text-zinc-300">GitHub & Feedback</label>
        <p class="text-xs text-zinc-400 font-mono leading-relaxed">
          For feature requests, edge-case PDF ingestion issues, or bugs, feel free to open an issue or pull request on the repository.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>